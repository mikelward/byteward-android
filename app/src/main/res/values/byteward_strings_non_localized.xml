<?xml version="1.0" encoding="utf-8"?>
<!--
    Byteward overrides for strings defined in the :ui module, which keeps
    upstream Bitwarden's text. App resources take precedence over library
    resources when they are merged, so the app shows these versions while the
    :ui files stay identical to upstream (and the Authenticator app, which also
    uses :ui, keeps Bitwarden's text).

    Each entry renames Bitwarden to Byteward where the password manager refers
    to itself. Text about Bitwarden's service is not overridden.
-->
<resources>
    <string name="bitwarden" translatable="false">Byteward</string>
</resources>
